@model EstudianteMVC.Models.Estudiante

<h2>➕ Nuevo Estudiante</h2>

<form method="post" class="card p-4 shadow" style="max-width: 400px;">

    <div class="mb-3">
        <label>Nombre</label>
        <input class="form-control" name="Nombre" required />
    </div>

    <div class="mb-3">
        <label>Apellido</label>
        <input class="form-control" name="Apellido" required />
    </div>

    <div class="mb-3">
        <label>Edad</label>
        <input class="form-control" type="number" name="Edad" required />
    </div>

    <div class="mb-3">
        <label>Correo</label>
        <input class="form-control" type="email" name="Correo" required />
    </div>

    <button class="btn btn-primary">Guardar</button>

</form>