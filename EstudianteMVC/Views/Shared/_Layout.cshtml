<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EstudianteMVC</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EstudianteMVC.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- 🔥 NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand" asp-controller="Estudiantes" asp-action="Index">
                    🎓 EstudianteMVC
                </a>

                <!-- Menu -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Estudiantes" asp-action="Index">
                                Estudiantes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Estudiantes" asp-action="Create">
                                Nuevo
                            </a>
                        </li>

                        
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Weather" asp-action="Index">
                                Weather
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENT -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - EstudianteMVC
        </div>
    </footer>

    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>